#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
set -vx

DIR=$(cd "$(dirname "$0")" && pwd)
OUTDIR="$DIR/../docs/html/jupyterlite"
CSS_FILE="static/custom.css"
CSS_LINK="<link rel=\"stylesheet\" href=\"$CSS_FILE\">"

cd $DIR/../jupyterlite

python -m pip install -r requirements.txt
jupyter lite build --contents content --output-dir $OUTDIR
mkdir -p "$OUTDIR/repl/static"
cp "repl/$CSS_FILE" "$OUTDIR/repl/static/"
sed -i "s|</head>|$CSS_LINK\n</head>|g" "$OUTDIR/repl/index.html"
